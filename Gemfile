source "https://rubygems.org"

# The site is built in its own GitHub Actions environment, so the writing
# pipeline is not limited to the GitHub Pages gem's older plugin allowlist.
gem "jekyll", "~> 4.4"
gem "jekyll-scholar", "~> 7.3"
gem "kramdown-parser-gfm", "~> 1.1"
gem "webrick", "~> 1.9"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
end
